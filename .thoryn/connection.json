  "apiVersion": "thoryn.io/connection/v1",
  "workspace": {
    "slug": "examples",
    "hubBaseUrlEnv": "THORYN_HUB"
  },
  "auth": {
    "method": "client_credentials",
    "clientId": "app-9450eb88-c1f",
    "secretEnv": "THORYN_EXAMPLES_CI_CLIENT_SECRET",
    "scopes": [
      "tenant:environments.write",
      "tenant:environments.read",
      "tenant:applications.write",
      "tenant:applications.read",
      "tenant:users.write",
      "tenant:users.read",
      "tenant:email.write",
      "tenant:email.read"
    ]
  }
}
