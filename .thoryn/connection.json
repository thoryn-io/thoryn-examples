{
  "apiVersion": "thoryn.io/connection/v1",
  "workspace": {
    "slug": "examples",
    "hubBaseUrlEnv": "THORYN_HUB"
  },
  "auth": {
    "method": "client_credentials",
    "clientId": "examples-ci",
    "secretEnv": "THORYN_EXAMPLES_CONFINED_CI_CLIENT_SECRET",
    "scopes": [
      "tenant:environments.read",
      "tenant:environments.write",
      "tenant:applications.read",
      "tenant:applications.write",
      "tenant:users.read",
      "tenant:users.write",
      "tenant:idp.read",
      "tenant:idp.write",
      "tenant:access.read",
      "tenant:access.write"
    ]
  }
}
