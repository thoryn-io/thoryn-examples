{
  "apiVersion": "thoryn.io/examples/v1",
  "id": "sandbox-signin",
  "version": "2.0.0",
  "summary": "Register a public loopback OAuth client in a sandbox environment you own, then sign in through the recipe's relying party.",
  "requires": {
    "scopes": [
      "tenant:applications.write",
      "tenant:applications.read"
    ],
    "minCliVersion": "0.3.7"
  },
  "params": [
    {
      "name": "workspaceSlug",
      "prompt": "Standing workspace slug (the workspace your API key is scoped to; NOT created)",
      "validate": "^[a-z0-9]([a-z0-9-]{1,61}[a-z0-9])$"
    },
    {
      "name": "appName",
      "prompt": "Display name for the OAuth client",
      "default": "Sandbox Sign-in App {{generate.slug8}}"
    }
  ],
  "steps": [
    {
      "id": "app",
      "action": "applications.create",
      "description": "Register a public loopback authorization-code client in the selected (sandbox) environment.",
      "with": {
        "displayName": "{{appName}}",
        "clientType": "public",
        "grantTypes": [
          "authorization_code"
        ],
        "scopes": [
          "openid",
          "profile",
          "email"
        ],
        "redirectUris": [
          "http://127.0.0.1/callback"
        ],
        "postLogoutRedirectUris": [
          "http://127.0.0.1/"
        ]
      }
    }
  ],
  "verify": [
    {
      "assert": "applications.get",
      "id": "{{app.clientId}}",
      "expect": {
        "status": "active"
      }
    }
  ],
  "teardown": [
    {
      "action": "applications.delete",
      "id": "{{app.clientId}}"
    }
  ],
  "assets": {
    "rp": "./apps/loopback-rp",
    "docs": "./README.md"
  }
}