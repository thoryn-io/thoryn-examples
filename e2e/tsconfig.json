{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@playwright/test": ["node_modules/@playwright/test"],
      "@playwright/test/*": ["node_modules/@playwright/test/*"]
    }
  },
  "include": [
    "lib/**/*.ts",
    "lib/**/*.mjs",
    "scripts/**/*.mjs",
    "playwright.config.ts",
    "../recipes/*/e2e/**/*.ts",
    "../recipes/*/e2e/**/*.mjs"
  ]
}
